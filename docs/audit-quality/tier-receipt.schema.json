        "inspection": {
          "enum": [
            "CONTENT_INSPECTED",
            "METADATA_ONLY",
            "BLOCKED",
            "NOT_CHECKED"
          ]
        },
        "artifact_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "covered_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "source_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1
        }
