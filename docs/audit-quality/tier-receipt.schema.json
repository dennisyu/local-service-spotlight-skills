        "interpretation": {
          "type": "string",
          "minLength": 1
        },
        "goal_consequence": {
          "type": "string",
          "minLength": 1
        },
        "buyer_consequence": {
          "type": "string",
          "minLength": 1
        },
        "action_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "next_verification": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
