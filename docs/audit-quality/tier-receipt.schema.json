        "purpose": {
          "enum": [
            "claim",
            "authority",
            "privacy",
            "fidelity",
            "provenance",
            "usability",
            "reproducibility",
            "identity",
            "gct",
            "measurement",
            "visual_function",
            "actions",
            "links_access",
            "unknowns",
            "corrections",
            "budget",
            "routing",
