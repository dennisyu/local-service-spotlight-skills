            "SOURCE_LEDGER",
            "METRIC_RECONCILIATION",
            "ACTION_REGISTER",
            "LINK_RECEIPT",
            "BUDGET_RECORD",
            "VISUAL_MANIFEST",
            "FIDELITY_CROSSWALK",
            "IDENTITY_MAPPING",
            "RENDER_REVIEW",
            "CAPABILITY_TEST",
            "FINDING_CLOSURE",
            "DELIVERY_READBACK",
            "CALIBRATION_RECORD"
